# Vercel frontend build environment variables (set to your Render service URL)
VITE_API_URL=https://YOUR-RENDER-SERVICE.onrender.com
VITE_SOCKET_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Render backend environment variables
NODE_ENV=production
PORT=3000
SESSION_SECRET=generate-a-long-random-secret
DATA_DIR=/var/data
FRONTEND_URL=https://YOUR-VERCEL-APP.vercel.app

# Firebase is configured in firebase.js. Enable Firebase Authentication > Anonymous,
# then publish database.rules.json in Firebase Realtime Database > Rules.
